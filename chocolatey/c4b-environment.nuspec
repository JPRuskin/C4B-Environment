<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>c4b-environment.powershell</id>
    <version>$version$</version>
    <owners>Chocolatey Software</owners>
    <title>Chocolatey for Business Environment Module</title>
    <authors>jpruskin</authors>
    <projectUrl>https://github.com/jpruskin/C4B-Environment</projectUrl>
    <licenseUrl>https://github.com/jpruskin/C4B-Environment/blob/main/LICENSE.md</licenseUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <projectSourceUrl>https://github.com/jpruskin/C4B-Environment/</projectSourceUrl>
    <packageSourceUrl>https://github.com/jpruskin/C4B-Environment/tree/main/chocolatey</packageSourceUrl>
    <bugTrackerUrl>https://github.com/jpruskin/C4B-Environment/issues</bugTrackerUrl>
    <tags>chocolatey business jenkins nexus chocolateycentralmanagement</tags>
    <summary>A PowerShell module written to deploy and maintain a Chocolatey For Business environment.</summary>
    <releaseNotes>https://github.com/JPRuskin/C4B-Environment/releases</releaseNotes>
    <description><![CDATA[
A PowerShell module containing functions written to deploy and maintain a [Chocolatey For Business](https://chocolatey.org/products/chocolatey-for-business) environment.
    ]]></description>
      <dependencies>
        <!-- dependency id="nexushell" version="1.0.0" / -->
      </dependencies>
    </metadata>
    <files>
      <file src="*.ps1" target="tools" />
      <file src="..\$version$\**" target="tools\module" />
    </files>
</package>
